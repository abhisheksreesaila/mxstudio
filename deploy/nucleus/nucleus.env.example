# Copy to a root-owned protected path and reference it with --env-file.
# Use root:mxstudio mode 0640, or root:<private invoking-user group> mode 0640.
# Generate unique random keys locally; blank keys deliberately fail preflight.
MXSTUDIO_NUCLEUS_API_KEY=
NUCLEUS_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# Fill the immutable 40-hex Hugging Face commit resolved for this run.
NUCLEUS_MODEL_REVISION=
MXSTUDIO_HOME=/var/lib/mxstudio
HF_HOME=/var/cache/mxstudio/huggingface
NUCLEUS_HOSTNAME=api.mxstudio.local

# Optional LAN discovery (install zeroconf first and set the ingress LAN address).
NUCLEUS_DISCOVERY_HOST=
NUCLEUS_DISCOVERY_ADDRESS=
NUCLEUS_DISCOVERY_PORT=443

# Optional LiteLLM + explicitly provisioned PostgreSQL.
DATABASE_URL=
LITELLM_MASTER_KEY=

# Only for the explicitly opted-in cloud example; never used by the local profile.
OPENAI_API_KEY=
