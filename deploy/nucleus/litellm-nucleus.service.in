[Unit]
Description=Optional LiteLLM Nucleus virtual-key gateway
After=postgresql.service mxstudio-nucleus.service
[Service]
Type=simple
User=@NUCLEUS_USER@
Group=@NUCLEUS_GROUP@
WorkingDirectory=@MXSTUDIO_ROOT@
EnvironmentFile=@NUCLEUS_ENV_FILE@
Environment=VIRTUAL_ENV=@MXSTUDIO_HOME@/.litellm-venv
Environment=PATH=@MXSTUDIO_HOME@/.litellm-venv/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=@MXSTUDIO_HOME@/.litellm-venv/bin/litellm --config @MXSTUDIO_ROOT@/deploy/nucleus/litellm_config.yaml --host 127.0.0.1 --port 4000
Restart=on-failure
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
